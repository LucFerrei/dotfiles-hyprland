set $mod Mod4

# Set direction keys (Vim-style)
set $left h
set $down j
set $up k
set $right l
# Move focus
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# Move the actual window
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# Your preferred terminal and launcher
set $term GTK_IM_MODULE=simple ghostty
# set $menu dmenu_path | wmenu | dmenu | bemenu-run | wofi --show run
set $menu wofi
set $explorer nautilus

### Keybindings
bindsym $mod+t exec $term
bindsym $mod+q kill
bindsym $mod+r exec $menu
bindsym $mod+c exec cliphist list | wofi --dmenu | cliphist decode | wl-copy
bindsym $mod+w exec cliphist wipe
bindsym $mod+Shift+x exec swaylock
bindsym $mod+Shift+backspace exec swaymsg exit
bindsym $mod+m layout toggle tabbed split
bindsym $mod+Shift+e exec swaymsg exit
bindsym $mod+Print exec hyprshot -m region -o /home/lucas/scheenshots/
bindsym $mod+e exec $explorer
bindsym $mod+f fullscreen toggle

# Switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
# ... (up to 10)
bindsym $mod+Shift+c reload

# Resize
mode "resize" {
    # Teclas Vim
    bindsym $left  resize grow width 10px
    bindsym $down  resize shrink height 10px
    bindsym $up    resize grow height 10px
    bindsym $right resize shrink width 10px

    # Teclas de Seta (Geralmente mais intuitivas para resize)
    bindsym Left   resize shrink width 10px
    bindsym Down   resize shrink height 10px
    bindsym Up     resize grow height 10px
    bindsym Right  resize grow width 10px

    # Voltar ao normal
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
# Bind the mode to a key (Physical Alt + R)
bindsym $mod+Shift+r mode "resize"
