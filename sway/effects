# Cantos arredondados
corner_radius 10
smart_corner_radius enable

# Blur leve, estilo vidro do macOS
blur_xray disable
blur_passes 1
blur_radius 5

# Sombras suaves
shadows enable
shadow_blur_radius 14
shadow_color #00000066

# Dim de janelas inativas
default_dim_inactive 0.06
dim_inactive_colors.unfocused #000000FF
dim_inactive_colors.urgent #900000FF

# Blur na barra e no launcher
layer_effects "waybar" {
    blur enable; blur_ignore_transparent enable;
}
layer_effects "wofi" {
    blur enable; blur_ignore_transparent enable;
}
