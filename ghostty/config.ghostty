# Config generated by Ghostty Config
# https://ghostty.zerebos.com
 
theme = Gruvbox Dark
# background = #0D0D0D
confirm-close-surface = false
font-family = JetBrainsMono Nerd Font
# font-family = IoskeleyMono Nerd Font
# font-family = IoskeleyMonoTerm Nerd Font
# font-family = Iosevka NF
# font-family = Departure Mono
# font-family = BigBlueTerm437 Nerd Font
# font-family = ProggyClean Nerd Font

font-size = 17
font-style = semiBold
font-feature = -calt

background-opacity = 0.8

fullscreen = false
window-vsync = true
gtk-titlebar = false

# keybinds
# keybind = ctrl+n=new_window
# keybind = ctrl+h=goto_split:left
# keybind = ctrl+j=goto_split:bottom
# keybind = ctrl+k=goto_split:top
# keybind = ctrl+l=goto_split:right
#
# keybind = ctrl+s>h=new_split:left
# keybind = ctrl+s>j=new_split:down
# keybind = ctrl+s>k=new_split:up
# keybind = ctrl+s>l=new_split:right
# keybind = ctrl+s>f=toggle_split_zoom
#
# keybind = ctrl+s>c=new_tab
# keybind = ctrl+s>n=next_tab
# keybind = ctrl+s>p=previous_tab
#
# keybind = ctrl+s>x=close_surface
#
# keybind = ctrl+shift+arrow_up=resize_split:up,10
# keybind = ctrl+shift+arrow_down=resize_split:down,10
# keybind = ctrl+shift+arrow_left=resize_split:left,10
# keybind = ctrl+shift+arrow_right=resize_split:right,10
# keybind = shift+ctrl+control_right=text:?

cursor-style = block
cursor-style-blink = true

unfocused-split-opacity = 0.1
window-inherit-working-directory = false
window-save-state = always
# unfocused-split-fill = #0D0D0D
split-preserve-zoom = true

# Vim-mode keybindings for Ghostty.
#
# Note: We're missing a number of actions to produce a better vim experience.
# This is what is possible today! But we plan on adding more actions to make
# this even better in the future.

# Entry point
keybind = alt+v=activate_key_table:vim

# Key table definition
keybind = vim/

# Line movement
keybind = vim/j=scroll_page_lines:1
keybind = vim/k=scroll_page_lines:-1

# Page movement
keybind = vim/ctrl+d=scroll_page_down
keybind = vim/ctrl+u=scroll_page_up
keybind = vim/ctrl+f=scroll_page_down
keybind = vim/ctrl+b=scroll_page_up
keybind = vim/shift+j=scroll_page_down
keybind = vim/shift+k=scroll_page_up

# Jump to top/bottom
keybind = vim/g>g=scroll_to_top
keybind = vim/shift+g=scroll_to_bottom

# Search (if you want vim-style search entry)
keybind = vim/slash=start_search
keybind = vim/n=navigate_search:next

# Copy mode / selection
# Note we're missing a lot of actions here to make this more full featured.
keybind = vim/v=copy_to_clipboard
keybind = vim/y=copy_to_clipboard

# Command Palette
keybind = vim/shift+semicolon=toggle_command_palette

# Exit
keybind = vim/escape=deactivate_key_table
keybind = vim/q=deactivate_key_table
keybind = vim/i=deactivate_key_table

# Catch unbound keys
keybind = vim/catch_all=ignore
